# =============================================================================
# AI Auditor — .env template
#
# Holds SECRETS + PLATFORM values only. Everything auditor/run-specific
# (auditor_id, engagement numbers, questionnaire tables, ingestion paths,
# AI-Scope / Scoping-Deck inputs) is passed through the API, NOT here.
#
# Key Vault: when it's live these same values are sourced from Azure Key Vault
# (secret name = the env-var name with '_' replaced by '-'). Until then, set
# KEY_VAULT_ENABLED=false (bottom of this file) and fill the values below.
# =============================================================================

# -- Azure OpenAI (chat) ------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-jnj-gateway.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2024-10-21        # use the version your deployment supports

# -- Azure OpenAI (embeddings) ------------------------------------------------
AZURE_EMBEDDING_ENDPOINT=https://your-jnj-gateway.openai.azure.com
AZURE_EMBEDDING_API_KEY=your-embedding-api-key
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072                   # MUST match the model (3-large=3072, 3-small/ada-002=1536)

# -- Azure Document Intelligence (OCR; optional — Tesseract is the fallback) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-di-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-di-key

# -- Tesseract OCR (fallback when Azure DI is absent) -------------------------
# Full path to the tesseract binary (avoids needing it on PATH).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# -- Azure AI Translator ------------------------------------------------------
# TRANSLATION_ENGINE=azure_translator to use Azure Translator; anything else => Azure OpenAI translates.
TRANSLATION_ENGINE=azure_translator
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/
AZURE_TRANSLATOR_KEY=your-translator-key
AZURE_TRANSLATOR_REGION=eastus
# Document-translation staging (optional):
AZURE_TRANSLATOR_DOCUMENT_ENDPOINT=https://your-translator-resource.cognitiveservices.azure.com/
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=your-container

# -- Azure AD service principal (Key Vault bootstrap + blob/OCR auth) ---------
# Required locally to reach Key Vault; on AKS the pod's managed identity is used instead.
AZURE_TENANT_ID=your-tenant-guid
AZURE_CLIENT_ID=your-sp-client-guid
AZURE_CLIENT_SECRET=your-sp-secret

# -- Databricks ---------------------------------------------------------------
# Auth is OAuth M2M via a service principal (NO PAT — DATABRICKS_TOKEN is retired).
DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_CLIENT_ID=your-databricks-sp-client-id
DATABRICKS_CLIENT_SECRET=your-databricks-sp-secret
DATABRICKS_CATALOG=nbod_gaagd
DATABRICKS_SCHEMA_NAME=cpr_risk_analysis
DATABRICKS_VECTOR_SEARCH_ENDPOINT=cpr_risk_analysis
DATABRICKS_WAREHOUSE_ID=your-warehouse-id

# -- Observability (Lakebase Postgres run tracing; optional) ------------------
OBS_ENABLED=false
LAKEBASE_INSTANCE_NAME=your-lakebase-instance

# -- Observability UI — Executive ROI assumptions -----------------------------
# The Executive dashboard estimates value as:
#   est_hours_saved = audits × OBS_MANUAL_HOURS_PER_AUDIT
#   est_value_usd   = est_hours_saved × OBS_ANALYST_HOURLY_USD
#   ROI%            = (est_value_usd − AI spend) ÷ AI spend
# IMPORTANT: these are the ONLY inputs that make the ROI "real" — set them to YOUR actual numbers.
# The defaults below are placeholders (a manual CPR scoping+risk pass ≈ 40 analyst hours, at a blended
# $120/hr). Replace with your organisation's real manual-effort estimate and blended analyst cost.
OBS_MANUAL_HOURS_PER_AUDIT=40
OBS_ANALYST_HOURLY_USD=120

# -- Global policy volumes (admin-managed knowledge sources) ------------------
HCBI_VOLUME_PATH=/Volumes/nbod_gaagd/cpr_risk_analysis/global_policies
POLICY_VOLUME_PATH=/Volumes/nbod_gaagd/cpr_risk_analysis/global_scope_area_policies
AUDITORS_SUPPORTING_DOCS_VOLUME_PATH=/Volumes/nbod_gaagd/cpr_risk_analysis/auditors_supporting_docs

# -- API server ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1               # keep 1: the run-status store is in-process (see Dockerfile note)

# -- Key Vault ----------------------------------------------------------------
# While the vault is being set up, run from .env only:
KEY_VAULT_ENABLED=false     # true => overlay secrets from Azure Key Vault (vault wins)
KEY_VAULT_STRICT=false      # true => a Key Vault failure is fatal (recommended for prod)
# AZURE_KEY_VAULT_NAME=gaa-cpr-risk-analysis-kv-dev   # or AZURE_KEY_VAULT_URL=https://<name>.vault.azure.net/

# -- Optional overrides (defaults live in src/config/constants.py) ------------
# HCBI_INDEX_NAME=hcbi_policy_index
# POLICY_INDEX_NAME=global_scope_area_policies
# SUPPORTING_DOCS_INDEX_NAME=auditor_supporting_docs_index
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K_HCBI=5
# TOP_K_POLICY=5
# TOP_K_SUPPORTING=5
# CONFLICT_SIMILARITY_THRESHOLD=0.90
# Translation pacing (anti-429) overrides:
# TRANSLATION_MAX_CONCURRENCY=1
# TRANSLATION_MIN_REQUEST_INTERVAL=1.0
# TRANSLATION_CHARS_PER_MINUTE=600000
# TRANSLATION_WORKERS=6
